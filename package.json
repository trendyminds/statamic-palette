	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.1.0",
		"autoprefixer": "^10.4.18",
		"laravel-vite-plugin": "^2.0.0",
		"postcss-import": "^16.0.1",
		"prettier": "^3.2.5",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hotkeys-hook": "^5.1.0",
		"tailwindcss": "^3.3.3",
		"vite": "^7.0.5"
	},
	"dependencies": {
		"@heroicons/react": "^2.0.18",
		"clsx": "^2.0.0",
		"heroicons": "^2.1.1",
		"jotai": "^2.12.5"
	},
	"prettier": {
